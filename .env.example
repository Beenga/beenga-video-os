# Copy to .env and fill in. .env is gitignored — never commit real tokens.

# Personal account token. Used for benchmarking.
REPLICATE_API_TOKEN=

# Organisation token (beenga). Billed separately — personal credit does NOT roll up.
# Only needed for pushing models under the beenga/ namespace.
REPLICATE_ORG_TOKEN=

# fal, for the Wan 2.2 A14B endpoints and the managed LoRA trainer.
FAL_KEY=

# rclone remote for the weight mirror. Must NOT be Hugging Face — the mirror only
# helps if it is a different failure domain. See PROVENANCE.md.
BEENGA_MIRROR=r2:beenga-weights
